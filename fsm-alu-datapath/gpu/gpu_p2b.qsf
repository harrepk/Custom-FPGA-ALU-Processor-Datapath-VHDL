set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY gpu_p2b
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name VHDL_FILE latch1.vhd
set_global_assignment -name VHDL_FILE fsm.vhd
set_global_assignment -name VHDL_FILE dec4to16.vhd
set_global_assignment -name VHDL_FILE alu.vhd
set_global_assignment -name VHDL_FILE sseg.vhd
set_global_assignment -name VHDL_FILE gpu_p2b.vhd

# ---- I/O pin assignments ----
set_location_assignment PIN_G26 -to Clock
set_location_assignment PIN_P23 -to Resetn
set_location_assignment PIN_AE23 -to Neg
set_location_assignment PIN_N25 -to A[0]
set_location_assignment PIN_N26 -to A[1]
set_location_assignment PIN_P25 -to A[2]
set_location_assignment PIN_AE14 -to A[3]
set_location_assignment PIN_AF14 -to A[4]
set_location_assignment PIN_AD13 -to A[5]
set_location_assignment PIN_AC13 -to A[6]
set_location_assignment PIN_C13 -to A[7]
set_location_assignment PIN_B13 -to B[0]
set_location_assignment PIN_A13 -to B[1]
set_location_assignment PIN_N1 -to B[2]
set_location_assignment PIN_P1 -to B[3]
set_location_assignment PIN_P2 -to B[4]
set_location_assignment PIN_T7 -to B[5]
set_location_assignment PIN_U3 -to B[6]
set_location_assignment PIN_U4 -to B[7]
set_location_assignment PIN_AF10 -to HEX_R1[0]
set_location_assignment PIN_AB12 -to HEX_R1[1]
set_location_assignment PIN_AC12 -to HEX_R1[2]
set_location_assignment PIN_AD11 -to HEX_R1[3]
set_location_assignment PIN_AE11 -to HEX_R1[4]
set_location_assignment PIN_V14 -to HEX_R1[5]
set_location_assignment PIN_V13 -to HEX_R1[6]
set_location_assignment PIN_V20 -to HEX_R2[0]
set_location_assignment PIN_V21 -to HEX_R2[1]
set_location_assignment PIN_W21 -to HEX_R2[2]
set_location_assignment PIN_Y22 -to HEX_R2[3]
set_location_assignment PIN_AA24 -to HEX_R2[4]
set_location_assignment PIN_AA23 -to HEX_R2[5]
set_location_assignment PIN_AB24 -to HEX_R2[6]
set_location_assignment PIN_AB23 -to HEX_id[0]
set_location_assignment PIN_V22 -to HEX_id[1]
set_location_assignment PIN_AC25 -to HEX_id[2]
set_location_assignment PIN_AC26 -to HEX_id[3]
set_location_assignment PIN_AB26 -to HEX_id[4]
set_location_assignment PIN_AB25 -to HEX_id[5]
set_location_assignment PIN_Y24 -to HEX_id[6]

set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top