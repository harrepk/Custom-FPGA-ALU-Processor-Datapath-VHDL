-- ============================================================
-- COE/BME 328 - Lab 6 : Seven-Segment Decoder (HEX)  [Part V]
-- Maps a 4-bit value (0..F) to a DE2 7-segment display.
-- Use one instance per HEX display: student_id digit, R1 (low), R2 (high).
--
-- POLARITY: ACTIVE-LOW (DE2 hardware) -> a '0' lights the segment.
-- Bit order of HEX is "gfedcba" : HEX(6)=g ... HEX(0)=a.
-- If your existing Lab-3 sseg is active-HIGH, reuse that one instead, or
-- invert every pattern below (and change WHEN OTHERS accordingly).
-- ============================================================
LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY sseg IS
    PORT ( bcd : IN  STD_LOGIC_VECTOR(3 DOWNTO 0);
           HEX : OUT STD_LOGIC_VECTOR(6 DOWNTO 0) );   -- "gfedcba", active-low
END sseg;

ARCHITECTURE Behavior OF sseg IS
BEGIN
    WITH bcd SELECT
        HEX <= "1000000" WHEN "0000",   -- 0
               "1111001" WHEN "0001",   -- 1
               "0100100" WHEN "0010",   -- 2
               "0110000" WHEN "0011",   -- 3
               "0011001" WHEN "0100",   -- 4
               "0010010" WHEN "0101",   -- 5
               "0000010" WHEN "0110",   -- 6
               "1111000" WHEN "0111",   -- 7
               "0000000" WHEN "1000",   -- 8
               "0010000" WHEN "1001",   -- 9
               "0001000" WHEN "1010",   -- A
               "0000011" WHEN "1011",   -- b
               "1000110" WHEN "1100",   -- C
               "0100001" WHEN "1101",   -- d
               "0000110" WHEN "1110",   -- E
               "0001110" WHEN "1111",   -- F
               "1111111" WHEN OTHERS;   -- blank
END Behavior;
